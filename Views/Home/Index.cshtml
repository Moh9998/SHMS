@model SHMS.Models.User

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>@Model.Role @Model.Name</p>
</div>

@if (Model.Role == UserRole.Doctor)
{
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Upload Tests</h5>
                        <p>Upload Test To Patient</p>
                        <a href="/TestResults/Upload" class="btn btn-primary">Upload</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Patient Test Results</h5>
                        <p class="card-text">View test results for a patient.</p>
                        <a href="/TestResults/Patient" class="btn btn-primary">View</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
